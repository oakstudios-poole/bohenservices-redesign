<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BOHEN Services Ltd</title>
  <meta name="description" content="BOHEN Services Ltd offers professional plumbing, heating and property maintenance services across Poole, Bournemouth and Christchurch." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --green: #88c86f;
      --green-dark: #5da848;
      --blue: #2d5f8e;
      --orange: #f39a12;
      --dark: #0f172a;
      --muted: #64748b;
      --light: #f8fafc;
      --shadow: 0 18px 50px rgba(15, 23, 42, 0.08);
      --radius: 24px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: white;
      color: var(--dark);
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1200px, calc(100% - 40px));
      margin: 0 auto;
    }

    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    }

    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 80px;
    }

    .logo {
      font-size: clamp(1.2rem, 2vw, 1.5rem);
      font-weight: 800;
      color: var(--blue);
      letter-spacing: -0.04em;
    }

    .logo span {
      color: var(--green-dark);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--dark);
      font-weight: 600;
      transition: color 0.2s ease;
    }

    nav a:hover,
    nav a:focus-visible {
      color: var(--green-dark);
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 140px 0 90px;
      background:
        radial-gradient(circle at top right, rgba(136, 200, 111, 0.25), transparent 35%),
        radial-gradient(circle at bottom left, rgba(45, 95, 142, 0.18), transparent 35%),
        white;
    }

    .hero-content {
      text-align: center;
      max-width: 860px;
    }

    .badge {
      display: inline-block;
      background: #ecfdf5;
      color: var(--green-dark);
      font-weight: 700;
      padding: 12px 20px;
      border-radius: 999px;
      margin-bottom: 22px;
    }

    h1 {
      font-size: clamp(3rem, 7vw, 5rem);
      line-height: 0.96;
      letter-spacing: -0.06em;
      margin-bottom: 22px;
    }

    h1 .highlight {
      display: block;
      color: var(--green-dark);
    }

    .hero p {
      max-width: 720px;
      margin: 0 auto;
      font-size: 1.15rem;
      color: var(--muted);
      line-height: 1.8;
    }

    .hero-actions {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 36px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 54px;
      padding: 0 28px;
      border-radius: 12px;
      font-weight: 700;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn:hover,
    .btn:focus-visible {
      transform: translateY(-1px);
    }

    .btn-primary {
      background: var(--orange);
      color: white;
      box-shadow: 0 10px 20px rgba(243, 154, 18, 0.25);
    }

    .btn-secondary {
      background: var(--green);
      color: white;
      box-shadow: 0 10px 20px rgba(136, 200, 111, 0.25);
    }

    section {
      padding: 100px 0;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 48px;
    }

    .section-heading h2 {
      font-size: clamp(2.3rem, 5vw, 3rem);
      letter-spacing: -0.05em;
      margin-bottom: 12px;
    }

    .section-heading p {
      color: var(--muted);
      font-size: 1.05rem;
    }

    .services-grid,
    .feature-grid,
    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 28px;
    }

    .card {
      background: white;
      border-radius: var(--radius);
      padding: 32px 28px;
      box-shadow: var(--shadow);
      border-top: 6px solid var(--green);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 24px 55px rgba(15, 23, 42, 0.12);
    }

    .card-icon {
      font-size: 3rem;
      margin-bottom: 18px;
    }

    .card h3 {
      color: var(--blue);
      margin-bottom: 12px;
      font-size: 1.5rem;
    }

    .card p {
      color: var(--muted);
      line-height: 1.8;
    }

    .green-section {
      background: linear-gradient(135deg, #ecfdf5 0%, #ffffff 100%);
    }

    .feature-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 22px;
      margin-top: 28px;
    }

    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(15, 23, 42, 0.06);
      border-radius: 18px;
      padding: 18px 18px;
    }

    .feature-bullet {
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: rgba(93, 168, 73, 0.12);
      color: var(--green-dark);
      font-weight: 800;
      flex-shrink: 0;
    }

    .feature-item h4 {
      margin-bottom: 6px;
      color: var(--dark);
    }

    .feature-item p {
      color: var(--muted);
      line-height: 1.7;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 20px;
      margin-top: 40px;
    }

    .stat {
      background: white;
      border-radius: 20px;
      padding: 24px 20px;
      text-align: center;
      border: 1px solid rgba(15, 23, 42, 0.05);
      box-shadow: var(--shadow);
    }

    .stat strong {
      display: block;
      font-size: clamp(2rem, 4vw, 2.5rem);
      color: var(--blue);
      line-height: 1.1;
    }

    .stat span {
      color: var(--muted);
      font-weight: 600;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 24px;
    }

    .project-card {
      background: white;
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid rgba(15, 23, 42, 0.06);
      box-shadow: var(--shadow);
    }

    .project-visual {
      height: 220px;
      background: linear-gradient(135deg, rgba(45, 95, 142, 0.1), rgba(136, 200, 111, 0.2));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4rem;
    }

    .project-info {
      padding: 22px 20px 26px;
    }

    .project-info h3 {
      color: var(--dark);
      margin-bottom: 8px;
    }

    .project-info p {
      color: var(--muted);
    }

    .testimonial-card {
      background: white;
      border-radius: 22px;
      padding: 28px 24px;
      box-shadow: var(--shadow);
      border-left: 6px solid var(--orange);
    }

    .stars {
      color: var(--orange);
      letter-spacing: 0.12em;
      margin-bottom: 14px;
    }

    .testimonial-card p {
      color: var(--muted);
      margin-bottom: 18px;
      line-height: 1.8;
    }

    .testimonial-card strong {
      color: var(--dark);
    }

    .contact-wrap {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 32px;
      align-items: stretch;
    }

    .contact-box,
    .contact-panel {
      background: white;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 32px 28px;
      border: 1px solid rgba(15, 23, 42, 0.05);
    }

    .contact-box h3,
    .contact-panel h3 {
      margin-bottom: 18px;
      color: var(--dark);
      font-size: clamp(1.8rem, 3vw, 2.1rem);
    }

    .contact-list {
      display: grid;
      gap: 18px;
      margin-top: 20px;
    }

    .contact-item {
      padding: 16px 18px;
      border-radius: 16px;
      background: #f8fafc;
      border: 1px solid rgba(15, 23, 42, 0.03);
    }

    .contact-item strong {
      display: block;
      margin-bottom: 4px;
      color: var(--blue);
    }

    .contact-item a,
    .contact-item span {
      color: var(--muted);
    }

    .cta-banner {
      background: linear-gradient(135deg, var(--blue), #3d7bb6);
      color: white;
      border-radius: 26px;
      padding: 42px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      box-shadow: 0 24px 60px rgba(45, 95, 142, 0.2);
    }

    .cta-banner h3 {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      margin-bottom: 8px;
    }

    .cta-banner p {
      opacity: 0.9;
    }

    footer {
      background: #0f172a;
      color: rgba(255, 255, 255, 0.8);
      padding: 34px 0;
      text-align: center;
    }

    @media (max-width: 760px) {
      nav {
        display: none;
      }

      .feature-list {
        grid-template-columns: 1fr;
      }

      .contact-wrap,
      .cta-banner {
        grid-template-columns: 1fr;
        display: grid;
      }

      .cta-banner {
        text-align: center;
      }
    }
  </style>
</head>
<body>
